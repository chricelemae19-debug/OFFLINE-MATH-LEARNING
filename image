<svg xmlns="http://www.w3.org/2000/svg"
     width="512"
     height="512"
     viewBox="0 0 512 512">

  <defs>
    <linearGradient id="bg"
                    x1="0"
                    y1="0"
                    x2="1"
                    y2="1">
      <stop offset="0%" stop-color="#0a2472"/>
      <stop offset="55%" stop-color="#7854e8"/>
      <stop offset="100%" stop-color="#12b878"/>
    </linearGradient>

    <linearGradient id="book"
                    x1="0"
                    y1="0"
                    x2="1"
                    y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#e8edff"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="512"
        height="512"
        rx="100"
        fill="url(#bg)"/>

  <!-- Decorative circles -->
  <circle cx="70"
          cy="80"
          r="28"
          fill="#ffba08"/>

  <circle cx="445"
          cy="95"
          r="20"
          fill="#ef476f"/>

  <circle cx="420"
          cy="430"
          r="35"
          fill="#06d6a0"/>

  <circle cx="80"
          cy="420"
          r="18"
          fill="#ffffff"
          opacity="0.8"/>

  <!-- Star -->
  <path d="M380 150
           L392 177
           L422 180
           L399 199
           L406 229
           L380 213
           L354 229
           L361 199
           L338 180
           L368 177 Z"
        fill="#ffba08"/>

  <!-- Open book -->
  <path d="M256 330
           C215 300 170 292 125 305
           L125 195
           C170 182 215 190 256 220 Z"
        fill="url(#book)"
        stroke="#061747"
        stroke-width="10"/>

  <path d="M256 330
           C297 300 342 292 387 305
           L387 195
           C342 182 297 190 256 220 Z"
        fill="url(#book)"
        stroke="#061747"
        stroke-width="10"/>

  <!-- Book center -->
  <line x1="256"
        y1="220"
        x2="256"
        y2="330"
        stroke="#061747"
        stroke-width="8"/>

  <!-- Math symbols -->
  <text x="150"
        y="265"
        font-family="Arial, sans-serif"
        font-size="54"
        font-weight="bold"
        fill="#ef476f">+</text>

  <text x="215"
        y="285"
        font-family="Arial, sans-serif"
        font-size="45"
        font-weight="bold"
        fill="#7854e8">×</text>

  <text x="285"
        y="270"
        font-family="Arial, sans-serif"
        font-size="50"
        font-weight="bold"
        fill="#12b878">÷</text>

  <text x="345"
        y="285"
        font-family="Arial, sans-serif"
        font-size="48"
        font-weight="bold"
        fill="#ffba08">−</text>

  <!-- Number -->
  <circle cx="256"
          cy="105"
          r="58"
          fill="#ffba08"
          stroke="#061747"
          stroke-width="8"/>

  <text x="256"
        y="125"
        text-anchor="middle"
        font-family="Arial, sans-serif"
        font-size="58"
        font-weight="bold"
        fill="#061747">3</text>

  <!-- Title -->
  <text x="256"
        y="390"
        text-anchor="middle"
        font-family="Arial, sans-serif"
        font-size="34"
        font-weight="bold"
        fill="#ffffff">MATH</text>

  <text x="256"
        y="428"
        text-anchor="middle"
        font-family="Arial, sans-serif"
        font-size="34"
        font-weight="bold"
        fill="#ffba08">ADVENTURE</text>

</svg>